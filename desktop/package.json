{
  "name": "voice-teleprompter",
  "productName": "Practice AI Teleprompter",
  "version": "1.0.3",
  "description": "טלפרומפטר קולי של פרקטי AI - גולל לפי הקול שלך ומוסתר מהקלטות מסך",
  "author": "Bar Shaltiel",
  "license": "MIT",
  "main": "main.js",
  "build": {
    "appId": "com.barshaltiel.voiceteleprompter",
    "productName": "Practice AI Teleprompter",
    "files": [
      "main.js",
      "preload.js",
      "bridge.html",
      "index.html",
      "whisper_server.py",
      "icon.png"
    ],
    "asarUnpack": [
      "whisper_server.py"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "טלפרומפטר פרקטי AI",
      "artifactName": "Practice-AI-Teleprompter-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extraResources": [
        {
          "from": "mac-helper/tp-speech",
          "to": "tp-speech"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "הטלפרומפטר מקשיב לקריאה שלך כדי לגלול את הטקסט",
        "NSSpeechRecognitionUsageDescription": "הטלפרומפטר מזהה את המילים שאתה מקריא כדי לדעת איפה אתה בטקסט"
      },
      "x64ArchFiles": "Contents/Resources/tp-speech"
    },
    "afterPack": "afterPack.js",
    "dmg": {
      "artifactName": "Practice-AI-Teleprompter-mac.dmg",
      "title": "Practice AI Teleprompter"
    }
  }
}
